{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Tic Tac Crazy (port 5000)",
      "type": "pwa-node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "Game running at (http://localhost:5000)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    }
  ]
}
